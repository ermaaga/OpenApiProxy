{
  "name": "@ermaga/openai-proxy",
  "version": "1.0.0",
  "description": "Local proxy that maps the Anthropic Messages API to OpenAI-compatible providers (NVIDIA NIM, Groq, OpenAI, etc.). Drop-in endpoint for Claude Code.",
  "publishConfig": {
    "access": "public"
  },
  "bin": {
    "openproxy": "bin/openproxy.js"
  },
  "scripts": {
    "start": "node src/server.js"
  },
  "files": [
    "bin/",
    "src/",
    "README.md"
  ],
  "engines": {
    "node": ">=18"
  },
  "keywords": [
    "claude",
    "claude-code",
    "anthropic",
    "openai",
    "proxy",
    "nvidia-nim",
    "groq",
    "llm",
    "cli"
  ],
  "license": "MIT"
}
